# Optional local environment file, loaded only when ENV_FILE points to it.
NODE_ENV=development
V1_PUBLIC_ORIGIN=http://localhost:3000
V1_TRUST_PROXY_HOPS=0
V1_STORE_DRIVER=atomic-file
V1_MEDIA_DRIVER=local
V1_LLM_PROVIDER=deterministic
V1_ASR_PROVIDER=none
V1_TTS_PROVIDER=none

# Production requires non-example values for every setting below.
# V1_SESSION_SECRET=
# DATABASE_URL=
# V1_MEDIA_DRIVER=azure-blob
# V1_AZURE_BLOB_CONTAINER=
# V1_AZURE_STORAGE_CONNECTION_STRING=
# V1_INSTANCE_POLICY=single
# V1_PRIVACY_NOTICE_VERSION=
# V1_PRIVACY_NOTICE_APPROVED=true
# V1_RETENTION_WORKER_ENABLED=true
